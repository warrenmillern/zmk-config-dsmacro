#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {  
    combos {
        compatible = "zmk,combos";
        combo_bt_layer {
            timeout-ms = <100>;
            key-positions = <15 16>;
            bindings = <&mo 1>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        physical-layout = <&dsmacro_physical_layout>;

        base_layer {
            display-name = "Base";
            bindings = < 
                &kp A   &kp B   &kp C   &kp D   &mo 1
                &kp F   &kp G   &kp H   &kp I   &kp J
                &kp K   &kp L   &kp M   &kp N   &kp O
                                &none   &kp Q   &kp R
            >;
        };

        bt_layer {
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR  &none
                &out OUT_USB &out OUT_BLE &none        &none          &none
                &none        &none        &none        &none          &bootloader
                                          &none        &none          &studio_unlock
            >;
        };
    };
};